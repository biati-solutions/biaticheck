# Vorlage für die Server-Konfiguration. Als ".env" in den Hauptordner kopieren und ausfüllen.
# Die Datei .env enthält Geheimnisse und gehört nicht ins Repository.

# Adresse, unter der BiatiCheck erreichbar ist (DNS muss auf den Server zeigen)
DOMAIN=test.biati.de

# Passwort der Datenbank. Erzeugen: openssl rand -hex 24
POSTGRES_PASSWORD=

# Schlüssel für die Verschlüsselung der hochgeladenen Abrechnungen (32 Byte, Base64). Pflicht.
# Erzeugen: openssl rand -base64 32
# Sicher aufbewahren: Ohne diesen Schlüssel sind gespeicherte Abrechnungen nicht mehr lesbar.
DATEI_SCHLUESSEL=

# Schlüssel der Claude API für das automatische Auslesen. Leer = jeder Fall geht an einen Experten.
ANTHROPIC_API_KEY=

# true = Ergebnisse werden erst nach Freigabe durch einen Experten sichtbar (empfohlen für den Start)
FREIGABE_ERFORDERLICH=true

# Uploads pro IP-Adresse und Stunde
UPLOADS_PRO_STUNDE=10

# Freischaltung des bezahlten Teils: "aus" (Standard) oder "test" (ohne Bezahlung, nur Testumgebung;
# dann zusätzlich ERLAUBE_TESTZAHLUNG=true)
ZAHLUNG_MODUS=aus
ERLAUBE_TESTZAHLUNG=false
